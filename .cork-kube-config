{
  "project" : "samwise",

  "environments" : {
    "prod" : {
      "project" : "digital-ucdavis-edu",
      "platform" : "microk8s",
      "namespace" : "samwise",
      "kubeconfig" : {
        "secret" : "kubeconfig-dev-libk8s",
        "context" : "microk8s"
      }
    }
  },

  "secrets" : {
    "prod" : [{
      "k8sName" : "oauth-client-secret",
      "mappings" : [{
        "gcsmName" : "samwise-keycloak-client-secret",
        "k8sProperty" : "secret"
      }]
    },{
      "k8sName" : "oauth-litellm-client-secret",
      "mappings" : [{
        "gcsmName" : "samwise-litellm-keycloak-client-secret",
        "k8sProperty" : "secret"
      }]
    },{
      "k8sName" : "open-webui-tls",
      "tls" : true,
      "certGcsmName" : "lib-ssl-cert",
      "keyGcsmName" : "lib-ssl-key"
    },{
      "k8sName" : "litellm-tls",
      "tls" : true,
      "certGcsmName" : "lib-ssl-cert",
      "keyGcsmName" : "lib-ssl-key"
    },{
      "k8sName" : "litellm-secret",
      "mappings" : [{
        "gcsmName" : "samwise-litellm-master-key",
        "k8sProperty" : "master-key"
      }]
    }]
  },

  "services" : [
    {
      "path" : "kustomize/postgres"
    },
    {
      "path" : "kustomize/open-webui"
    },
    {
      "path" : "kustomize/vllm/overlays/cyberdyne02-qwen38"
    },
    {
      "path" : "kustomize/vllm/overlays/cyberdyne01-qwen38"
    },
    {
      "path" : "kustomize/litellm"
    },
    {
      "path" : "kustomize/litellm-proxy"
    }
  ]
}
